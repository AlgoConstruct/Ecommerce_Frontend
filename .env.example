# Copy this file to .env.local and fill in values for your local Medusa backend.
# Without these, the storefront falls back to `baseUrl: undefined` with no
# diagnostic and every real-data request silently fails.

# Base URL of the Medusa backend (admin/store API), no trailing slash.
VITE_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key for the storefront's sales channel.
# Find/create one in the Medusa admin under Settings > API Key Management,
# or print it from the backend's seeded data.
VITE_MEDUSA_PUBLISHABLE_KEY=
